{
  "name": "levis-heritage-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/styles/**/*.css\" --max-warnings 0 --cache --cache-location node_modules/.cache/stylelint/",
    "test": "vitest run",
    "build": "node scripts/prepare-dist.mjs && npm run typecheck && npm test && vite build",
    "assets:og": "node scripts/run-python.mjs scripts/create-og-image.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
