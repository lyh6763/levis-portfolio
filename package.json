{
  "name": "levis-heritage-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:generated": "vite --mode generated",
    "dev:placeholder": "vite --mode placeholder",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/prepare-dist.mjs && tsc --noEmit && vite build && node scripts/copy-404.mjs",
    "build:generated": "node scripts/prepare-dist.mjs && tsc --noEmit && vite build --mode generated && node scripts/copy-404.mjs",
    "build:placeholder": "node scripts/prepare-dist.mjs && tsc --noEmit && vite build --mode placeholder && node scripts/copy-404.mjs",
    "assets:placeholders": "node scripts/create-placeholders.mjs",
    "assets:generated": "node scripts/run-python.mjs scripts/optimize-generated-images.py",
    "assets:og": "node scripts/run-python.mjs scripts/create-og-image.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
